{
  "version": "2.0.0",
  "notes": [
    "Single source of truth for provider, account, execution and model configuration.",
    "No adapter may hard-code a CLI flag, profile directory or model id.",
    "Antigravity model lists were enumerated live with `agy --app_data_dir=<dir> models`.",
    "dangerously_skip_permissions is false everywhere: headless execution was verified to succeed without it."
  ],
  "concurrency": {
    "max_concurrent_agents": 2,
    "rationale": "2 CPU cores / 16 GB host; bounded to avoid oversubscription."
  },
  "providers": {
    "antigravity": {
      "id": "antigravity",
      "name": "Google Antigravity",
      "description": "Autonomous multi-agent execution across isolated account profiles",
      "enabled": true,
      "command": "/home/setoo/.gemini/bin/agy",
      "fallback_commands": [
        "/home/setoo/.local/bin/agy",
        "/home/setoo/.local/bin/antigravity",
        "/usr/local/bin/antigravity"
      ],
      "profile_root": "~/.gemini",
      "accounts": {
        "antigravity-account-1": {
          "agent_id": "antigravity-account-1",
          "account_id": "account-1",
          "enabled": true,
          "description": "Signed-in Google account; master architect and deep reasoning",
          "execution": {
            "command": "/home/setoo/.gemini/bin/agy",
            "app_data_dir": "antigravity-cli",
            "output_format": "json",
            "dangerously_skip_permissions": false,
            "default_timeout_seconds": 300
          },
          "capabilities": [
            "architecture",
            "protocol-design",
            "governance",
            "deep-reasoning",
            "documentation"
          ],
          "models": [
            "gemini-3.1-pro-high",
            "gemini-3.1-pro-low",
            "claude-opus-4-6-thinking",
            "claude-sonnet-4-6",
            "gemini-3.8-flash-high",
            "gemini-3.8-flash-medium",
            "gemini-3.8-flash-low",
            "gemini-3.7-flash-high",
            "gemini-3.7-flash-medium",
            "gemini-3.7-flash-low",
            "gemini-3.6-flash-high",
            "gemini-3.6-flash-medium",
            "gemini-3.6-flash-low",
            "gpt-oss-120b-medium"
          ],
          "default_model": "gemini-3.8-flash-medium"
        },
        "antigravity-account-2": {
          "agent_id": "antigravity-account-2",
          "account_id": "account-2",
          "enabled": true,
          "description": "Second Antigravity account, headless via the antigravity-ide profile; multi-file refactoring, component work and code review",
          "execution": {
            "command": "/home/setoo/.gemini/bin/agy",
            "app_data_dir": "antigravity-ide",
            "output_format": "json",
            "dangerously_skip_permissions": false,
            "default_timeout_seconds": 300
          },
          "capabilities": [
            "editor-refactoring",
            "component-refactoring",
            "code-review",
            "architecture",
            "deep-reasoning",
            "test-scaffolding"
          ],
          "models": [
            "gemini-3.1-pro-high",
            "gemini-3.1-pro-low",
            "claude-opus-4-6-thinking",
            "claude-sonnet-4-6",
            "gemini-3.8-flash-high",
            "gemini-3.8-flash-medium",
            "gemini-3.8-flash-low",
            "gemini-3.7-flash-high",
            "gemini-3.7-flash-medium",
            "gemini-3.7-flash-low",
            "gemini-3.6-flash-high",
            "gemini-3.6-flash-medium",
            "gemini-3.6-flash-low",
            "gpt-oss-120b-medium"
          ],
          "default_model": "gemini-3.8-flash-medium"
        }
      }
    },
    "kiro": {
      "id": "kiro",
      "name": "Kiro",
      "description": "Headless command-line agent for terminal operations, cloud reads and testing",
      "enabled": true,
      "command": "/home/setoo/.local/bin/kiro-cli",
      "models_verified_with": "kiro-cli chat --model <invalid> (the CLI lists valid ids in its error)",
      "accounts": {
        "kiro-cli": {
          "agent_id": "kiro-cli",
          "account_id": "cli",
          "enabled": true,
          "capabilities": [
            "terminal-operations",
            "local-validation",
            "build-and-test",
            "cloud-read-only",
            "kubernetes-read-only"
          ],
          "models": [
            "auto",
            "claude-opus-5",
            "claude-sonnet-5",
            "gpt-5.6-sol",
            "gpt-5.6-terra",
            "gpt-5.6-luna",
            "claude-sonnet-4.6",
            "claude-sonnet-4.5",
            "claude-sonnet-4",
            "claude-haiku-4.5",
            "deepseek-3.2",
            "minimax-m2.5",
            "minimax-m2.1",
            "glm-5",
            "qwen3-coder-next"
          ],
          "default_model": "auto"
        }
      }
    },
    "cline": {
      "id": "cline",
      "name": "Cline",
      "description": "Headless focused-coding and UI styling agent",
      "enabled": true,
      "command": "/home/setoo/.local/bin/cline",
      "models_verified_with": "not enumerable from the CLI; only 'auto' is relied upon",
      "accounts": {
        "cline": {
          "agent_id": "cline",
          "account_id": "cli",
          "enabled": true,
          "capabilities": [
            "editor-refactoring",
            "frontend-styling",
            "component-refactoring",
            "code-review"
          ],
          "models": [
            "auto"
          ],
          "default_model": "auto"
        }
      }
    }
  },
  "future_providers": {
    "note": "Not implemented. Documents the registration lifecycle a new ProviderAdapter follows so the core brain never changes: REGISTER -> AUTHENTICATE -> HEALTH CHECK -> DISCOVER MODELS -> DISCOVER CAPABILITIES -> REGISTER AGENT -> ROUTER -> MISSION CONTROL.",
    "gemini-api": {
      "enabled": false,
      "status": "not-implemented"
    }
  }
}
