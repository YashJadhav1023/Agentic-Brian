# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# Environments & Dependencies
.env
.env.local
*.env
!.env.example
venv/
.venv/
env/
node_modules/

# Secrets, Keys & Credentials
*.key
*.pem
*.cert
*.crt
*service-account*.json
secrets*
creds*

# Runtime data & locks (ephemeral state)
runtime/logs/*
!runtime/logs/.gitkeep
runtime/cache/*
!runtime/cache/.gitkeep
runtime/temporary/*
!runtime/temporary/.gitkeep
runtime/sandboxes/*
!runtime/sandboxes/.gitkeep
runtime/*.token
*.token
locks/*.lock
locks/*.json
!locks/.gitkeep
sessions/*.json
!sessions/.gitkeep
events/*.jsonl
events/*.log
!events/.gitkeep

# Ephemeral runtime databases & journals
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# Local test & task execution records
tasks/queue/*.json
tasks/active/*.json
tasks/completed/*.json
tasks/failed/*.json
handoffs/archive/*.md
handoffs/archive/*.json

# Local user configs & OS caches
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
